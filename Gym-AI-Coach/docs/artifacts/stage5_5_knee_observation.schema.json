{
  "$defs": {
    "ErrorCategory": {
      "enum": [
        "technical_error",
        "measurement_error",
        "insufficient_data",
        "segmentation_error",
        "informational_observation",
        "input_error",
        "configuration_error",
        "operational_error"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "Exercise": {
      "enum": [
        "BodyWeightSquats",
        "HandstandPushups"
      ],
      "title": "Exercise",
      "type": "string"
    },
    "FeatureAvailability": {
      "additionalProperties": false,
      "description": "Ready means prerequisites pass; it never means geometry has been computed.",
      "properties": {
        "definition": {
          "$ref": "#/$defs/FeatureDefinition"
        },
        "definition_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Hash",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/StructuredFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "input": {
          "$ref": "#/$defs/FeatureInputContext"
        },
        "input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/FlagCode"
          },
          "title": "Reasons",
          "type": "array"
        },
        "registry_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Registry Hash",
          "type": "string"
        },
        "registry_version": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Registry Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready_for_calculation",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "registry_version",
        "registry_hash",
        "definition",
        "definition_hash",
        "input",
        "input_hash",
        "status",
        "reasons",
        "flags"
      ],
      "title": "FeatureAvailability",
      "type": "object"
    },
    "FeatureDefinition": {
      "additionalProperties": false,
      "properties": {
        "definition_version": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Definition Version",
          "type": "string"
        },
        "exercises": {
          "items": {
            "$ref": "#/$defs/Exercise"
          },
          "minItems": 1,
          "title": "Exercises",
          "type": "array"
        },
        "feature_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Feature Id",
          "type": "string"
        },
        "feature_schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Feature Schema Version",
          "type": "string"
        },
        "formula": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Formula",
          "type": "string"
        },
        "joint_policy": {
          "$ref": "#/$defs/JointInputPolicy"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "measurement_definition": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Measurement Definition",
          "type": "string"
        },
        "measurement_method": {
          "enum": [
            "joint_angle_abc",
            "midpoint_axis_angle_vertical",
            "horizontal_offset_torso_ratio",
            "normalized_euclidean_distance"
          ],
          "title": "Measurement Method",
          "type": "string"
        },
        "measurement_tier": {
          "$ref": "#/$defs/MeasurementTier"
        },
        "name": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Name",
          "type": "string"
        },
        "quality_policy": {
          "$ref": "#/$defs/FeatureQualityPolicy"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "required_joints": {
          "items": {
            "$ref": "#/$defs/JointName"
          },
          "minItems": 1,
          "title": "Required Joints",
          "type": "array"
        },
        "roles": {
          "items": {
            "enum": [
              "descriptive",
              "informational",
              "segmentation_candidate"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "source_references": {
          "items": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source References",
          "type": "array"
        },
        "source_tiers": {
          "items": {
            "$ref": "#/$defs/SourceTier"
          },
          "minItems": 1,
          "title": "Source Tiers",
          "type": "array"
        },
        "unavailable_reasons": {
          "items": {
            "$ref": "#/$defs/FlagCode"
          },
          "minItems": 1,
          "title": "Unavailable Reasons",
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/FeatureUnit"
        },
        "validation": {
          "$ref": "#/$defs/FeatureValidation"
        },
        "viewpoint_policy": {
          "$ref": "#/$defs/ViewpointPolicy"
        }
      },
      "required": [
        "definition_version",
        "feature_id",
        "name",
        "exercises",
        "measurement_definition",
        "measurement_method",
        "formula",
        "required_joints",
        "joint_policy",
        "quantity_kind",
        "unit",
        "measurement_tier",
        "source_tiers",
        "source_references",
        "validation",
        "viewpoint_policy",
        "quality_policy",
        "roles",
        "unavailable_reasons",
        "limitations"
      ],
      "title": "FeatureDefinition",
      "type": "object"
    },
    "FeatureInputContext": {
      "additionalProperties": false,
      "description": "Snapshots of existing contracts; no new coordinates or quality decisions.",
      "properties": {
        "frame": {
          "$ref": "#/$defs/ProcessedPoseFrame"
        },
        "quality": {
          "$ref": "#/$defs/QualityReport"
        }
      },
      "required": [
        "frame",
        "quality"
      ],
      "title": "FeatureInputContext",
      "type": "object"
    },
    "FeatureQualityPolicy": {
      "additionalProperties": false,
      "properties": {
        "metric_key": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Metric Key",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Reason",
          "type": "string"
        },
        "require_exact_metric_joints": {
          "const": true,
          "title": "Require Exact Metric Joints",
          "type": "boolean"
        },
        "require_metric_allow": {
          "const": true,
          "title": "Require Metric Allow",
          "type": "boolean"
        },
        "require_sequence_allow": {
          "const": true,
          "title": "Require Sequence Allow",
          "type": "boolean"
        },
        "requires_mid_hip_origin": {
          "title": "Requires Mid Hip Origin",
          "type": "boolean"
        },
        "requires_valid_scale": {
          "title": "Requires Valid Scale",
          "type": "boolean"
        }
      },
      "required": [
        "metric_key",
        "require_sequence_allow",
        "require_metric_allow",
        "require_exact_metric_joints",
        "requires_valid_scale",
        "requires_mid_hip_origin",
        "reason"
      ],
      "title": "FeatureQualityPolicy",
      "type": "object"
    },
    "FeatureUnit": {
      "enum": [
        "degrees",
        "torso_lengths",
        "dimensionless_ratio"
      ],
      "title": "FeatureUnit",
      "type": "string"
    },
    "FeatureValidation": {
      "additionalProperties": false,
      "properties": {
        "assessment_status": {
          "const": "blocked_pending_expert_validation",
          "title": "Assessment Status",
          "type": "string"
        },
        "calculation_status": {
          "const": "not_implemented",
          "title": "Calculation Status",
          "type": "string"
        },
        "measurement_status": {
          "enum": [
            "unvalidated",
            "blocked"
          ],
          "title": "Measurement Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "measurement_status",
        "reason",
        "calculation_status",
        "assessment_status"
      ],
      "title": "FeatureValidation",
      "type": "object"
    },
    "FlagCode": {
      "enum": [
        "invalid_config",
        "invalid_pose_input",
        "invalid_pose_sequence",
        "invalid_preprocessing_input",
        "quality_input_mismatch",
        "smoothing_short_run",
        "preprocessing_error",
        "preprocessing_serialization_error",
        "unknown_feature_id",
        "unsupported_exercise",
        "invalid_viewpoint",
        "invalid_feature_input",
        "invalid_feature_context_index",
        "feature_context_mismatch",
        "unsupported_feature_calculation",
        "invalid_geometry_input",
        "degenerate_geometry",
        "geometry_numerical_error",
        "feature_definition_blocked",
        "feature_joint_unusable",
        "feature_provenance_rejected",
        "feature_quality_blocked",
        "feature_metric_eligibility_missing",
        "feature_quality_policy_mismatch",
        "pose_backend_error",
        "pose_not_detected",
        "missing_joint",
        "missing_landmark_field",
        "non_finite_landmark",
        "invalid_landmark_confidence",
        "pose_serialization_error",
        "unreadable_video",
        "video_too_short",
        "invalid_fps",
        "invalid_video_resolution",
        "invalid_frame_count",
        "insufficient_sequence_length",
        "excessive_missingness",
        "low_pose_visibility",
        "partial_joint_coverage",
        "single_side_only",
        "side_switch_discontinuity",
        "normalization_origin_fallback",
        "normalization_scale_fallback",
        "viewpoint_unknown",
        "viewpoint_mismatch",
        "partial_rep_start",
        "partial_rep_end",
        "multi_person",
        "out_of_frame",
        "low_signal_range",
        "unstable_signal",
        "segmentation_failed",
        "assessment_unavailable"
      ],
      "title": "FlagCode",
      "type": "string"
    },
    "FlagLocation": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature"
        },
        "frame_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame End"
        },
        "frame_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Start"
        },
        "joint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joint"
        },
        "rep_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rep Index"
        },
        "video_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Id"
        }
      },
      "title": "FlagLocation",
      "type": "object"
    },
    "InterpolationSource": {
      "additionalProperties": false,
      "properties": {
        "left_frame_index": {
          "minimum": 0,
          "title": "Left Frame Index",
          "type": "integer"
        },
        "left_status": {
          "const": "observed",
          "default": "observed",
          "title": "Left Status",
          "type": "string"
        },
        "left_timestamp_seconds": {
          "minimum": 0,
          "title": "Left Timestamp Seconds",
          "type": "number"
        },
        "right_frame_index": {
          "minimum": 0,
          "title": "Right Frame Index",
          "type": "integer"
        },
        "right_status": {
          "const": "observed",
          "default": "observed",
          "title": "Right Status",
          "type": "string"
        },
        "right_timestamp_seconds": {
          "minimum": 0,
          "title": "Right Timestamp Seconds",
          "type": "number"
        }
      },
      "required": [
        "left_frame_index",
        "right_frame_index",
        "left_timestamp_seconds",
        "right_timestamp_seconds"
      ],
      "title": "InterpolationSource",
      "type": "object"
    },
    "JointGapSpan": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "length": {
          "exclusiveMinimum": 0,
          "title": "Length",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "start_frame",
        "end_frame",
        "length"
      ],
      "title": "JointGapSpan",
      "type": "object"
    },
    "JointInputPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_provenance": {
          "items": {
            "$ref": "#/$defs/JointProvenance"
          },
          "minItems": 1,
          "title": "Allowed Provenance",
          "type": "array"
        },
        "coordinate_source": {
          "const": "stage4_processed_xy",
          "title": "Coordinate Source",
          "type": "string"
        },
        "imputation_policy_reason": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Imputation Policy Reason",
          "type": "string"
        },
        "require_finite_xy": {
          "const": true,
          "title": "Require Finite Xy",
          "type": "boolean"
        },
        "require_usable": {
          "const": true,
          "title": "Require Usable",
          "type": "boolean"
        }
      },
      "required": [
        "coordinate_source",
        "allowed_provenance",
        "require_usable",
        "require_finite_xy",
        "imputation_policy_reason"
      ],
      "title": "JointInputPolicy",
      "type": "object"
    },
    "JointName": {
      "enum": [
        "nose",
        "left_shoulder",
        "right_shoulder",
        "left_elbow",
        "right_elbow",
        "left_wrist",
        "right_wrist",
        "left_hip",
        "right_hip",
        "left_knee",
        "right_knee",
        "left_ankle",
        "right_ankle"
      ],
      "title": "JointName",
      "type": "string"
    },
    "JointProvenance": {
      "enum": [
        "observed",
        "low_visibility",
        "imputed",
        "missing"
      ],
      "title": "JointProvenance",
      "type": "string"
    },
    "JointQuality": {
      "additionalProperties": false,
      "properties": {
        "consecutive_invalid_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JointGapSpan"
          },
          "title": "Consecutive Invalid Spans",
          "type": "array"
        },
        "invalid_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Ratio"
        },
        "low_visibility_frames": {
          "minimum": 0,
          "title": "Low Visibility Frames",
          "type": "integer"
        },
        "max_consecutive_invalid_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Max Consecutive Invalid Frames",
          "type": "integer"
        },
        "missing_frames": {
          "minimum": 0,
          "title": "Missing Frames",
          "type": "integer"
        },
        "observed_frames": {
          "minimum": 0,
          "title": "Observed Frames",
          "type": "integer"
        },
        "observed_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Ratio"
        },
        "out_of_frame_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Out Of Frame Frames",
          "type": "integer"
        },
        "out_of_frame_observed_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Out Of Frame Observed Frames",
          "type": "integer"
        },
        "total_frames": {
          "minimum": 0,
          "title": "Total Frames",
          "type": "integer"
        }
      },
      "required": [
        "total_frames",
        "observed_frames",
        "low_visibility_frames",
        "missing_frames"
      ],
      "title": "JointQuality",
      "type": "object"
    },
    "MeasurementTier": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3"
      ],
      "title": "MeasurementTier",
      "type": "string"
    },
    "MetricEligibility": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "allow",
            "degrade",
            "skip"
          ],
          "title": "Action",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "required_joints": {
          "items": {
            "$ref": "#/$defs/JointName"
          },
          "title": "Required Joints",
          "type": "array"
        }
      },
      "required": [
        "eligible",
        "action",
        "required_joints"
      ],
      "title": "MetricEligibility",
      "type": "object"
    },
    "NormalizationTransform": {
      "additionalProperties": false,
      "properties": {
        "distance_ratio_eligible": {
          "title": "Distance Ratio Eligible",
          "type": "boolean"
        },
        "origin_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin X"
        },
        "origin_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Y"
        },
        "scale_status": {
          "enum": [
            "torso",
            "fallback_unit"
          ],
          "title": "Scale Status",
          "type": "string"
        },
        "torso_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Torso Scale"
        },
        "translation_status": {
          "enum": [
            "mid_hip",
            "fallback_origin"
          ],
          "title": "Translation Status",
          "type": "string"
        }
      },
      "required": [
        "translation_status",
        "scale_status",
        "distance_ratio_eligible"
      ],
      "title": "NormalizationTransform",
      "type": "object"
    },
    "ProcessedJoint": {
      "additionalProperties": false,
      "properties": {
        "interpolation": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterpolationSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "joint": {
          "$ref": "#/$defs/JointName"
        },
        "pre_normalization_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Normalization X"
        },
        "pre_normalization_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Normalization Y"
        },
        "smoothing_status": {
          "enum": [
            "smoothed",
            "skipped_short_run",
            "unavailable"
          ],
          "title": "Smoothing Status",
          "type": "string"
        },
        "source_status": {
          "enum": [
            "observed",
            "low_visibility",
            "missing"
          ],
          "title": "Source Status",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/JointProvenance"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlagCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unsmoothed_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsmoothed X"
        },
        "unsmoothed_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsmoothed Y"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "joint",
        "source_status",
        "status",
        "usable",
        "smoothing_status"
      ],
      "title": "ProcessedJoint",
      "type": "object"
    },
    "ProcessedPoseFrame": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StructuredFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "joints": {
          "items": {
            "$ref": "#/$defs/ProcessedJoint"
          },
          "title": "Joints",
          "type": "array"
        },
