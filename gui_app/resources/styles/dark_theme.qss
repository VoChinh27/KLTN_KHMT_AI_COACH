QWidget { background:#1e1f24; color:#e6e6e6; font-size:13px; }
QPushButton { background:#2d6cdf; border:none; border-radius:6px; padding:7px 14px; }
QPushButton:hover { background:#3b7bf0; } QPushButton:disabled { background:#3a3b40; color:#777; }
QLineEdit, QPlainTextEdit, QTextBrowser, QComboBox, QDateTimeEdit, QSpinBox, QTreeWidget, QTableWidget
 { background:#2a2b31; border:1px solid #3a3b40; border-radius:4px; padding:4px; }
QTabBar::tab { background:#2a2b31; padding:9px 18px; } QTabBar::tab:selected { background:#2d6cdf; }
QTabBar::tab:disabled { color:#666; }
QGroupBox { border:1px solid #3a3b40; border-radius:6px; margin-top:10px; padding-top:10px; }
QFrame#SportCard { background:#2a2b31; border:1px solid #3a3b40; border-radius:10px; }
QLabel#Title { font-size:24px; font-weight:bold; } QLabel#CardTitle { font-size:18px; font-weight:bold; }
QProgressBar { border:1px solid #3a3b40; border-radius:4px; text-align:center; }
QProgressBar::chunk { background:#2ecc71; }
QFrame#ErrorCard { background:#2a2b31; border:2px solid #e74c3c; border-radius:8px; }
QFrame#PhaseCard { background:#2a2b31; border:1px solid #3a3b40; border-radius:8px; }
QHeaderView::section { background:#2a2b31; border:none; padding:5px; }
QScrollBar:vertical { background:#1e1f24; width:10px; } QScrollBar::handle:vertical { background:#3a3b40; border-radius:5px; }
QToolTip { background:#2a2b31; color:#fff; border:1px solid #3a3b40; }
